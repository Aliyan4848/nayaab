# =====================================================================
# NAYAAB — Environment Variables
# Copy to .env.local for local dev. Never commit the real .env file.
# =====================================================================

# --- Database (Supabase Postgres, via Prisma) — SERVER ONLY -------------
DATABASE_URL="postgresql://user:password@host:5432/nayaab?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/nayaab?schema=public"

# --- Supabase — SERVER + CLIENT ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="public-anon-key"        # safe for browser
SUPABASE_SERVICE_ROLE_KEY="service-role-key"            # SERVER ONLY — never expose

# --- Media storage (choose one) — SERVER ONLY ----------------------------
STORAGE_PROVIDER="supabase"    # "supabase" | "cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Transactional email — SERVER ONLY ------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="NAYAAB <orders@yourdomain.com>"

# --- WhatsApp (official Business/Cloud API) — SERVER ONLY ----------------
WHATSAPP_PROVIDER="none"       # "none" | "meta_cloud_api"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_NUMBER="+92XXXXXXXXXX"   # public sales number, used for wa.me links (safe client-side)
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER="+92XXXXXXXXXX"   # same number, exposed to the browser for the "Order on WhatsApp" button

# --- Admin bootstrap — SERVER ONLY ----------------------------------------
ADMIN_SETUP_TOKEN=""           # one-time token required to create the first admin account
SESSION_SECRET=""              # random 32+ char secret for signing session cookies

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
