cat > .gitignore << 'EOF'
# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env
.env
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/migrations/dev.db
EOF

git add .gitignore
git commit -m "fix: correct .gitignore to actually ignore .env and node_modules"
git push